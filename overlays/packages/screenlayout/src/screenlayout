#!/usr/bin/env racket
#lang racket/base
;; -*- mode: racket -*-

(require racket/string
         racket/list
         racket/function
         racket/port
         racket/file
         racket/path
         racket/cmdline)

(define (parse template name)
  (define template-length (length template))
  (define parts (string-split name "."))
  (when (< (length parts) template-length)
    (error (format
            "can not match template ~a to name ~a, unsatisfied parts length"
            template parts)))
  (map cons template (take parts template-length)))

(define (find db filter)
  (car (or (memf (lambda (v)
                   (andmap
                    (lambda (v f) (equal? v f))
                    (take (cdr v) (length filter))
                    filter))
                 db)
           (list #f))))

(define (execute path)
  (let-values (((p out in err)
                (subprocess #f #f
                            (current-error-port)
                            (find-executable-path path))))
    (subprocess-wait p)
    (let ((code (subprocess-status p)))
      (when (not (= code 0))
        (error (format "command ~a exited with ~a code"
                       path code))))
    (string-trim (port->string out) "\n" #:left? #f #:right? #t)))

(define (main)
  (define layouts-directory (make-parameter "~/.screenlayout"))
  (define hostname          (make-parameter (execute "hostname")))
  (define layout            (make-parameter #f))

  (command-line
   #:program "screenlayout"
   #:usage-help "configure screen layout with selected arandr script"
   #:once-any
   (("-l" "--layouts")  l "Layouts directory" (layouts-directory l))
   (("-n" "--hostname") h "Hostname"          (hostname          h))
   #:args (layout)
   (let* ((directory (expand-user-path (layouts-directory)))
          (scripts (map path->string (directory-list directory)))
          (db (for/list ((name scripts))
                (cons name (parse '(host layout) name))))
          (filter `((host . ,(hostname)) (layout . ,layout)))
          (record (find db filter)))
     (when (not record)
       (error (format "could not find layout with filter ~a" filter)))
     (void (execute (path->string (build-path directory (car record))))))))

(main)
