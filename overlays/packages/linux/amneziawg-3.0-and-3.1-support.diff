diff --git a/drivers/net/wireguard/header_protection.c b/drivers/net/wireguard/header_protection.c
new file mode 100644
index 000000000000..81526d33d391
--- /dev/null
+++ b/drivers/net/wireguard/header_protection.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "header_protection.h"
+#include "device.h"
+
+#include <linux/unaligned.h>
+
+bool awg_header_protection_init(struct chacha_state *state,
+				struct wg_device *wg, const u8 *nonce)
+{
+	struct header_protection *p = &wg->header_protection;
+	u8 iv[CHACHA_IV_SIZE];
+	bool res = false;
+
+	down_read(&p->lock);
+	if (!p->has_protection)
+		goto out;
+
+	memset(iv, 0, CHACHA_IV_SIZE - HEADER_PROTECTION_NONCE_SIZE);
+	memcpy(iv + CHACHA_IV_SIZE - HEADER_PROTECTION_NONCE_SIZE, nonce,
+	       HEADER_PROTECTION_NONCE_SIZE);
+	chacha_init(state, p->key, iv);
+	res = true;
+out:
+	up_read(&p->lock);
+	return res;
+}
+
+void awg_header_protection_set_key(struct header_protection *p,
+				   const u8 key[HEADER_PROTECTION_KEY_SIZE])
+{
+	int i;
+
+	down_write(&p->lock);
+	for (i = 0; i < CHACHA_KEY_WORDS; ++i)
+		p->key[i] = get_unaligned_le32(key + i * sizeof(u32));
+	p->has_protection = true;
+	up_write(&p->lock);
+}
+
+bool awg_header_protection_get_key(struct header_protection *p,
+				   u8 key[HEADER_PROTECTION_KEY_SIZE])
+{
+	bool res;
+	int i;
+
+	down_read(&p->lock);
+	res = p->has_protection;
+	if (res) {
+		for (i = 0; i < CHACHA_KEY_WORDS; ++i)
+			put_unaligned_le32(p->key[i], key + i * sizeof(u32));
+	}
+	up_read(&p->lock);
+	return res;
+}
diff --git a/drivers/net/wireguard/header_protection.h b/drivers/net/wireguard/header_protection.h
new file mode 100644
index 000000000000..7d86a66e68c5
--- /dev/null
+++ b/drivers/net/wireguard/header_protection.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _WG_HEADER_PROTECTION_H
+#define _WG_HEADER_PROTECTION_H
+
+#include <linux/types.h>
+#include <linux/rwsem.h>
+#include <crypto/chacha.h>
+
+struct wg_device;
+
+enum header_protection_lengths {
+	HEADER_PROTECTION_KEY_SIZE = CHACHA_KEY_SIZE,
+	HEADER_PROTECTION_NONCE_SIZE = 12
+};
+
+struct header_protection {
+	u32 key[CHACHA_KEY_WORDS];
+	struct rw_semaphore lock;
+	bool has_protection;
+};
+
+bool awg_header_protection_init(struct chacha_state *state,
+				struct wg_device *wg, const u8 *nonce);
+void awg_header_protection_set_key(struct header_protection *p,
+				   const u8 key[HEADER_PROTECTION_KEY_SIZE]);
+bool awg_header_protection_get_key(struct header_protection *p,
+				   u8 key[HEADER_PROTECTION_KEY_SIZE]);
+
+#endif /* _WG_HEADER_PROTECTION_H */
