new file mode 100644
index 000000000000..eadedddb70d3
--- /dev/null
+++ b/drivers/net/wireguard/range.h
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _WG_RANGE_H
+#define _WG_RANGE_H
+
+#include <linux/random.h>
+#include <linux/types.h>
+
+struct wg_u32_range {
+	u64 packed;
+};
+
+static inline struct wg_u32_range wg_u32_range_from_packed(u64 packed)
+{
+	return (struct wg_u32_range){ .packed = packed };
+}
+
+static inline u64 wg_u32_range_packed(struct wg_u32_range range)
+{
+	return range.packed;
+}
+
+static inline void wg_u32_range_init(struct wg_u32_range *range, u32 lo,
+				     u32 hi)
+{
+	range->packed = (u64)hi << 32 | (u64)lo;
+}
+
+static inline u32 wg_u32_range_lo(struct wg_u32_range range)
+{
+	return (u32)range.packed;
+}
+
+static inline u32 wg_u32_range_hi(struct wg_u32_range range)
+{
+	return (u32)(range.packed >> 32);
+}
+
+static inline bool wg_u32_range_contains(struct wg_u32_range range, u32 val)
+{
+	return wg_u32_range_lo(range) <= val && val <= wg_u32_range_hi(range);
+}
+
+static inline bool wg_u32_range_is_zero(struct wg_u32_range range)
+{
+	return range.packed == 0;
+}
+
+static inline bool wg_u32_range_is_valid(struct wg_u32_range range)
+{
+	return wg_u32_range_lo(range) <= wg_u32_range_hi(range);
+}
+
+static inline bool wg_u32_range_overlap(struct wg_u32_range left,
+					struct wg_u32_range right)
+{
+	return wg_u32_range_lo(left) <= wg_u32_range_hi(right) &&
+	       wg_u32_range_lo(right) <= wg_u32_range_hi(left);
+}
+
+static inline u32 wg_u32_range_pick_one(struct wg_u32_range range)
+{
+	return get_random_u32_inclusive(wg_u32_range_lo(range),
+					wg_u32_range_hi(range));
+}
+
+struct wg_u16_range {
+	u32 packed;
+};
+
+static inline struct wg_u16_range wg_u16_range_from_packed(u32 packed)
+{
+	return (struct wg_u16_range){ .packed = packed };
+}
+
+static inline u32 wg_u16_range_packed(struct wg_u16_range range)
+{
+	return range.packed;
+}
+
+static inline void wg_u16_range_init(struct wg_u16_range *range, u16 lo,
+				     u16 hi)
+{
+	range->packed = (u32)hi << 16 | (u32)lo;
+}
+
+static inline u16 wg_u16_range_lo(struct wg_u16_range range)
+{
+	return (u16)range.packed;
+}
+
+static inline u16 wg_u16_range_hi(struct wg_u16_range range)
+{
+	return (u16)(range.packed >> 16);
+}
+
+static inline bool wg_u16_range_contains(struct wg_u16_range range, u16 val)
+{
+	return wg_u16_range_lo(range) <= val && val <= wg_u16_range_hi(range);
+}
+
+static inline bool wg_u16_range_is_zero(struct wg_u16_range range)
+{
+	return range.packed == 0;
+}
+
+static inline bool wg_u16_range_is_valid(struct wg_u16_range range)
+{
+	return wg_u16_range_lo(range) <= wg_u16_range_hi(range);
+}
+
+static inline bool wg_u16_range_overlap(struct wg_u16_range left,
+					struct wg_u16_range right)
+{
+	return wg_u16_range_lo(left) <= wg_u16_range_hi(right) &&
+	       wg_u16_range_lo(right) <= wg_u16_range_hi(left);
+}
+
+static inline u16 wg_u16_range_pick_one(struct wg_u16_range range)
+{
+	return get_random_u32_inclusive(wg_u16_range_lo(range),
+					wg_u16_range_hi(range));
+}
+
+static inline u16 wg_u16_range_pick_or(struct wg_u16_range range,
+				       u16 fallback)
+{
+	return wg_u16_range_is_zero(range) ? fallback :
+		wg_u16_range_pick_one(range);
+}
+
+static inline u16 wg_u16_range_lo_or(struct wg_u16_range range, u16 fallback)
+{
+	return wg_u16_range_is_zero(range) ? fallback : wg_u16_range_lo(range);
+}
+
+static inline u16 wg_u16_range_hi_or(struct wg_u16_range range, u16 fallback)
+{
+	return wg_u16_range_is_zero(range) ? fallback : wg_u16_range_hi(range);
+}
+
+#endif /* _WG_RANGE_H */
