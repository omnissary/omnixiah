+	n2 wg set wg0 h1 100-110
+	awg_expire_session
+	n1 ping -W 5 -c 1 192.168.241.2
+
+	# Re-publish the RCU-owned configuration while both softirq paths are busy.
+	n2 iperf3 -s -1 -B 192.168.241.2 &
+	server_pid=$!
+	waitiperf $netns2 $server_pid
+	n1 iperf3 -Z -t 5 -c 192.168.241.2 &
+	client_pid=$!
+	while kill -0 "$client_pid" 2>/dev/null; do
+		n1 wg set wg0 header-protection-key <(echo "$hpkey") s4 16 content-padding-addition 4-12
+		n2 wg set wg0 header-protection-key <(echo "$hpkey") s4 16 content-padding-addition 4-12
+	done
+	wait $client_pid
+	wait $server_pid
+
+	# Recreate the pair so the upstream counter checks start from zero and the
+	# remainder of the suite exercises the baseline defaults.
+	ip1 link del dev wg0
+	ip2 link del dev wg0
+	ip0 link add dev wg0 type wireguard
+	ip0 link set wg0 netns $netns1
+	ip0 link add dev wg0 type wireguard
+	ip0 link set wg0 netns $netns2
+	configure_peers
+}
+
+# Stock wireguard-tools does not know the AWG fields. Keep the upstream suite
+# usable with it, while running the extension tests when an AWG-capable wg is
+# embedded by the QEMU harness.
+if n1 wg show wg0 jc >/dev/null 2>&1; then
+	awg_tests
+fi
