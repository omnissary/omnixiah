@@ -118,7 +118,7 @@ static bool magic_header_is_default(const struct magic_header *mh, u32 value)
 }
 
 static bool magic_headers_overlap(const struct magic_header *left,
-					 const struct magic_header *right)
+				  const struct magic_header *right)
 {
 	return !(right->end < left->start || left->end < right->start);
 }
@@ -255,9 +255,6 @@ static void wg_destruct(struct net_device *dev)
 	struct wg_device *wg = netdev_priv(dev);
 	int i;
 
-	for (i = 0; i < ARRAY_SIZE(wg->ispecs); ++i)
-		jp_spec_free(&wg->ispecs[i]);
-
 	rtnl_lock();
 	list_del(&wg->device_list);
 	rtnl_unlock();
@@ -270,6 +267,8 @@ static void wg_destruct(struct net_device *dev)
 	destroy_workqueue(wg->handshake_receive_wq);
 	destroy_workqueue(wg->handshake_send_wq);
 	destroy_workqueue(wg->packet_crypt_wq);
+	for (i = 0; i < ARRAY_SIZE(wg->ispecs); ++i)
+		jp_spec_free(&wg->ispecs[i]);
 	wg_packet_queue_free(&wg->handshake_queue, true);
 	wg_packet_queue_free(&wg->decrypt_queue, false);
 	wg_packet_queue_free(&wg->encrypt_queue, false);
