+						dev->name);
 	if (!wg->handshake_send_wq)
 		goto err_destroy_handshake_receive;
 
@@ -500,10 +500,12 @@ void wg_device_uninit(void)
 	rcu_barrier();
 }
 
-int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *asc)
+int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *asc,
+				 char **ispec_descs, u32 ispec_mask)
 {
 	struct wg_device *wg = netdev_priv(dev);
 	struct amnezia_config config = *asc;
+	struct jp_spec parsed_ispecs[ARRAY_SIZE(wg->ispecs)] = {};
 	struct magic_header *headers[] = {
 		&config.init_packet_magic_header,
 		&config.response_packet_magic_header,
@@ -538,14 +540,14 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 
 	if (config.junk_packet_max_size >= MESSAGE_MAX_SIZE) {
 		net_dbg_ratelimited("%s: JunkPacketMaxSize: %d; should be smaller than maxSegmentSize: %d\n",
-								dev->name, config.junk_packet_max_size,
-								MESSAGE_MAX_SIZE);
+				    dev->name, config.junk_packet_max_size,
+				    MESSAGE_MAX_SIZE);
 		ret = -EINVAL;
 		goto out;
 	} else if (config.junk_packet_max_size < config.junk_packet_min_size) {
 		net_dbg_ratelimited("%s: maxSize: %d; should be greater than minSize: %d\n",
-								dev->name, config.junk_packet_max_size,
-								config.junk_packet_min_size);
+				    dev->name, config.junk_packet_max_size,
+				    config.junk_packet_min_size);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -555,8 +557,8 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 
 	if (config.init_packet_junk_size + MESSAGE_INITIATION_SIZE >= MESSAGE_MAX_SIZE) {
 		net_dbg_ratelimited("%s: init header size (%d) + junkSize (%d) should be smaller than maxSegmentSize: %d\n",
-		                    dev->name, MESSAGE_INITIATION_SIZE,
-								config.init_packet_junk_size, MESSAGE_MAX_SIZE);
+				    dev->name, MESSAGE_INITIATION_SIZE,
+				    config.init_packet_junk_size, MESSAGE_MAX_SIZE);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -566,8 +568,9 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 
 	if (config.response_packet_junk_size + MESSAGE_RESPONSE_SIZE >= MESSAGE_MAX_SIZE) {
 		net_dbg_ratelimited("%s: response header size (%d) + junkSize (%d) should be smaller than maxSegmentSize: %d\n",
-		                    dev->name, MESSAGE_RESPONSE_SIZE,
-		                    config.response_packet_junk_size, MESSAGE_MAX_SIZE);
+				    dev->name, MESSAGE_RESPONSE_SIZE,
+				    config.response_packet_junk_size,
+				    MESSAGE_MAX_SIZE);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -577,8 +580,9 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 
 	if (config.cookie_packet_junk_size + MESSAGE_COOKIE_REPLY_SIZE >= MESSAGE_MAX_SIZE) {
 		net_dbg_ratelimited("%s: cookie header size (%d) + junkSize (%d) should be smaller than maxSegmentSize: %d\n",
-								dev->name, MESSAGE_COOKIE_REPLY_SIZE,
-								config.cookie_packet_junk_size, MESSAGE_MAX_SIZE);
+				    dev->name, MESSAGE_COOKIE_REPLY_SIZE,
+				    config.cookie_packet_junk_size,
+				    MESSAGE_MAX_SIZE);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -588,8 +592,9 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 
 	if (config.transport_packet_junk_size + MESSAGE_TRANSPORT_SIZE >= MESSAGE_MAX_SIZE) {
 		net_dbg_ratelimited("%s: transport header size (%d) + junkSize (%d) should be smaller than maxSegmentSize: %d\n",
-								dev->name, MESSAGE_TRANSPORT_SIZE,
-								config.transport_packet_junk_size, MESSAGE_MAX_SIZE);
+				    dev->name, MESSAGE_TRANSPORT_SIZE,
+				    config.transport_packet_junk_size,
+				    MESSAGE_MAX_SIZE);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -612,28 +617,41 @@ int wg_device_handle_post_config(struct net_device *dev, struct amnezia_config *
 	}
 
 	for (i = 0; i < ARRAY_SIZE(wg->ispecs); ++i) {
-		ret = jp_spec_setup(&wg->ispecs[i]);
-		if (ret) {
-			net_dbg_ratelimited("%s: I%d-packet invalid format\n",
-					    dev->name, i + 1);
+		if (ispec_mask & (1U << i)) {
+			ret = jp_spec_parse(&parsed_ispecs[i], ispec_descs[i]);
+			if (ret) {
+				net_dbg_ratelimited("%s: I%d-packet invalid format\n",
+						    dev->name, i + 1);
 				goto out;
-		}
-		if (wg->ispecs[i].pkt_size > 0)
+			}
+			if (parsed_ispecs[i].pkt_size > 0)
+				a_sec_on = true;
+		} else if (wg->ispecs[i].pkt_size > 0) {
 			a_sec_on = true;
+		}
 	}
 
 	if (MESSAGE_INITIATION_SIZE + config.init_packet_junk_size ==
 	    MESSAGE_RESPONSE_SIZE + config.response_packet_junk_size) {
 		net_dbg_ratelimited("%s: new init size:%d; and new response size:%d; should differ\n",
-		                    dev->name,
-		                    MESSAGE_INITIATION_SIZE + config.init_packet_junk_size,
-		                    MESSAGE_RESPONSE_SIZE + config.response_packet_junk_size);
+				    dev->name,
+				    MESSAGE_INITIATION_SIZE + config.init_packet_junk_size,
+				    MESSAGE_RESPONSE_SIZE + config.response_packet_junk_size);
 		ret = -EINVAL;
 		goto out;
 	}
 
 	config.advanced_security = a_sec_on;
 	wg->advanced_security_config = config;
+	for (i = 0; i < ARRAY_SIZE(wg->ispecs); ++i) {
+		if (!(ispec_mask & (1U << i)))
+			continue;
+		jp_spec_commit(&wg->ispecs[i], ispec_descs[i],
