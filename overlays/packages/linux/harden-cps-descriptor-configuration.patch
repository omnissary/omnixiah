 drivers/net/wireguard/device.h  |  5 ++-
 drivers/net/wireguard/junk.c    | 75 +++++++++++++++++++++------------
 drivers/net/wireguard/junk.h    |  4 ++
 drivers/net/wireguard/netlink.c | 68 +++++++++---------------------
 5 files changed, 120 insertions(+), 104 deletions(-)

