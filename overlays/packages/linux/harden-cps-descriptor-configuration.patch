 }
 
-int jp_spec_setup(struct jp_spec *spec)
+void jp_spec_free(struct jp_spec *spec)
+{
+	kfree(spec->desc);
+	spec->desc = NULL;
+	jp_spec_free_packet(spec);
+}
+
+int jp_spec_parse(struct jp_spec *spec, const char *desc)
 {
 	struct jp_modifier *mod;
 	struct jp_tag *tag, *tmp;
-	char *buf;
+	char *buf = NULL;
 	int err = 0;
 	int mods_size;
 	int pkt_size;
 	LIST_HEAD(head);
 
-	mutex_lock(&spec->lock);
+	jp_spec_free_packet(spec);
 
-	kfree(spec->pkt);
-	kfree(spec->mods);
-	spec->pkt = NULL;
-	spec->mods = NULL;
-	spec->pkt_size = 0;
-	spec->mods_size = 0;
-
-	if (!spec->desc) {
-		mutex_unlock(&spec->lock);
+	if (!desc)
 		return 0;
-	}
 
-	buf = kstrdup(spec->desc, GFP_KERNEL);
+	buf = kstrdup(desc, GFP_KERNEL);
 	if (!buf) {
 		err = -ENOMEM;
 		goto out;
@@ -285,18 +281,17 @@ int jp_spec_setup(struct jp_spec *spec)
 	pkt_size = 0;
 	mods_size = 0;
 	list_for_each_entry(tag, &head, head) {
+		if (tag->pkt_size > MESSAGE_MAX_SIZE - pkt_size) {
+			err = -EINVAL;
+			goto out;
+		}
 		pkt_size += tag->pkt_size;
 		if (tag->func)
 			++mods_size;
 	}
 
-	if (pkt_size > MESSAGE_MAX_SIZE) {
-		err = -EINVAL;
-		goto out;
-	}
-
 	spec->pkt = kzalloc(pkt_size, GFP_KERNEL);
-	spec->mods = kzalloc(mods_size * sizeof(*spec->mods), GFP_KERNEL);
+	spec->mods = kcalloc(mods_size, sizeof(*spec->mods), GFP_KERNEL);
 	if (!spec->pkt || !spec->mods) {
 		err = -ENOMEM;
 		goto out;
@@ -318,16 +313,44 @@ int jp_spec_setup(struct jp_spec *spec)
 	}
 
 out:
+	if (err)
+		jp_spec_free_packet(spec);
 	list_for_each_entry_safe(tag, tmp, &head, head) {
 		jp_tag_free(tag);
 		list_del(&tag->head);
 		kfree(tag);
 	}
 	kfree(buf);
+	return err;
+}
+
+int jp_spec_setup(struct jp_spec *spec)
+{
+	int err;
+
+	mutex_lock(&spec->lock);
+	err = jp_spec_parse(spec, spec->desc);
 	mutex_unlock(&spec->lock);
 	return err;
 }
 
+void jp_spec_commit(struct jp_spec *spec, char *desc, struct jp_spec *parsed)
+{
+	mutex_lock(&spec->lock);
+	kfree(spec->desc);
+	jp_spec_free_packet(spec);
+	spec->desc = desc;
+	spec->pkt = parsed->pkt;
+	spec->mods = parsed->mods;
+	spec->pkt_size = parsed->pkt_size;
+	spec->mods_size = parsed->mods_size;
+	parsed->pkt = NULL;
+	parsed->mods = NULL;
+	parsed->pkt_size = 0;
+	parsed->mods_size = 0;
+	mutex_unlock(&spec->lock);
+}
+
 void jp_spec_applymods(struct jp_spec *spec, struct wg_peer *peer)
 {
 	struct jp_modifier *mod;
