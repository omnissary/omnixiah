+static inline const char *u16_range_spec(uint32_t range)
+{
+	uint16_t lo = (uint16_t)range, hi = (uint16_t)(range >> 16);
+	static char buf[32];
+
+	if (lo == hi)
+		snprintf(buf, sizeof(buf), "%u", lo);
+	else
+		snprintf(buf, sizeof(buf), "%u-%u", lo, hi);
+	return buf;
+}
