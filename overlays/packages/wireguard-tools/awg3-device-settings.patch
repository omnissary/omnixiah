+static inline bool parse_bool(bool *device_value, const char *name, const char *value)
+{
+	if (!strcasecmp(value, "off") || !strcmp(value, "0")) {
+		*device_value = false;
+		return true;
+	}
+	if (!strcasecmp(value, "on") || !strcmp(value, "1")) {
+		*device_value = true;
+		return true;
+	}
+	fprintf(stderr, "Unable to parse %s as on or off: `%s`\n", name, value);
+	return false;
+}
+
+static inline bool parse_persistent_keepalive(uint32_t *interval, uint32_t *flags, const char *value)
