+	for (size_t i = 0; awg_special_handshake_keys[i]; ++i) {
+		if (!strncasecmp(input_key, awg_special_handshake_keys[i], 2)) {
+			special_handshake_key = true;
+			break;
+		}
+	}
+
+	if (special_handshake_key) {
+		size_t value_end = 0;
+		bool found_equals = false, found_value_start = false;
+
+		for (size_t i = len; i > 0; --i) {
+			if (!char_is_space(input[i - 1])) {
+				value_end = i;
+				break;
+			}
+		}
+
+		for (size_t i = 0; i < value_end; ++i) {
+			if (!found_equals) {
+				if (input[i] == '=') {
+					line[cleaned_len++] = input[i];
+					found_equals = true;
+				} else if (!char_is_space(input[i])) {
+					line[cleaned_len++] = input[i];
+				}
+			} else if (!found_value_start) {
+				if (!char_is_space(input[i])) {
+					line[cleaned_len++] = input[i];
+					found_value_start = true;
+				}
+			} else {
+				line[cleaned_len++] = input[i];
+			}
+		}
+	} else {
+		for (size_t i = 0; i < len; ++i) {
+			if (!char_is_space(input[i]))
+				line[cleaned_len++] = input[i];
+		}
