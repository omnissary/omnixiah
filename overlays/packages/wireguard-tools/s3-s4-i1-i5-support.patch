+static int nvlist_get_awg_string(const nvlist_t *nvl, const char *name, char **out)
+{
+	const void *binary;
+	size_t size;
+
+	if (!nvlist_exists_binary(nvl, name))
+		return 0;
+
+	binary = nvlist_get_binary(nvl, name, &size);
+	if (!binary || !size || size > MAX_AWG_STRING_LEN || ((const char *)binary)[size - 1])
+		return 0;
+
+	*out = strdup((const char *)binary);
+	if (!*out)
+		return -ENOMEM;
+
+	return 1;
+}
