+static bool awg_range_parse(const char *desc, uint64_t *range)
+{
+	unsigned long lo, hi;
+	char *end;
+
+	lo = strtoul(desc, &end, 10);
+	if (end == desc || lo > UINT32_MAX)
+		return false;
+	if (*end == '-') {
+		const char *rest = end + 1;
+
+		hi = strtoul(rest, &end, 10);
+		if (end == rest || hi > UINT32_MAX)
+			return false;
+	} else {
+		hi = lo;
+	}
+	if (*end != '\0' || lo > hi)
+		return false;
+
+	*range = (uint64_t)hi << 32 | (uint64_t)lo;
+	return true;
+}
+
+static char *awg_range_format(uint64_t range)
+{
+	uint32_t lo = (uint32_t)range, hi = (uint32_t)(range >> 32);
+	char buf[32];
+
+	if (lo == hi)
+		snprintf(buf, sizeof(buf), "%u", lo);
+	else
+		snprintf(buf, sizeof(buf), "%u-%u", lo, hi);
+	return strdup(buf);
+}
