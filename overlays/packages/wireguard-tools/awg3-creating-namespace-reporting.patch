diff --git a/src/ipc-linux.h b/src/ipc-linux.h
index cf9c23d..247dc92 100644
--- a/src/ipc-linux.h
+++ b/src/ipc-linux.h
@@ -6,6 +6,8 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdint.h>
+#include <dirent.h>
+#include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <errno.h>
@@ -16,6 +18,7 @@
 #include <linux/genetlink.h>
 #include <linux/if_link.h>
 #include <linux/netlink.h>
