 };
 
+struct netns_map_entry {
+	int32_t nsid;
+	char *name;
+	struct netns_map_entry *next;
+};
+
+struct netns_id {
+	int32_t value;
+	bool found;
+};
+
+static struct netns_map_entry *netns_map;
+
+static int parse_netns_id(const struct nlattr *attr, void *data)
+{
+	struct netns_id *id = data;
+
+	if (mnl_attr_get_type(attr) == NETNSA_NSID &&
+	    !mnl_attr_validate(attr, MNL_TYPE_U32)) {
+		id->value = mnl_attr_get_s32(attr);
+		id->found = true;
+	}
+	return MNL_CB_OK;
+}
+
+static int read_netns_id_cb(const struct nlmsghdr *nlh, void *data)
+{
+	if (nlh->nlmsg_type != RTM_NEWNSID) {
+		errno = EBADMSG;
+		return MNL_CB_ERROR;
+	}
+	if (mnl_attr_parse(nlh, sizeof(struct rtgenmsg), parse_netns_id, data) < 0)
+		return MNL_CB_ERROR;
+	return MNL_CB_STOP;
+}
+
+static int netns_id_from_fd(struct mnl_socket *nl, void *buffer, int fd,
+			    unsigned int seq)
+{
+	struct netns_id id = { .value = -1 };
+	struct nlmsghdr *nlh;
+	struct rtgenmsg *rtg;
+	unsigned int portid = mnl_socket_get_portid(nl);
+	ssize_t len;
+
+	nlh = mnl_nlmsg_put_header(buffer);
+	nlh->nlmsg_type = RTM_GETNSID;
+	nlh->nlmsg_flags = NLM_F_REQUEST;
+	nlh->nlmsg_seq = seq;
+	rtg = mnl_nlmsg_put_extra_header(nlh, sizeof(*rtg));
+	rtg->rtgen_family = AF_UNSPEC;
+	mnl_attr_put_u32(nlh, NETNSA_FD, fd);
+
+	if (mnl_socket_sendto(nl, buffer, nlh->nlmsg_len) < 0)
+		return -1;
+	if ((len = mnl_socket_recvfrom(nl, buffer, SOCKET_BUFFER_SIZE)) < 0)
+		return -1;
+	if (mnl_cb_run(buffer, len, seq, portid, read_netns_id_cb, &id) < 0 ||
+	    !id.found)
+		return -1;
+	return id.value;
+}
+
+static const char *netns_map_find(int32_t nsid)
+{
+	struct netns_map_entry *entry;
+
+	for (entry = netns_map; entry; entry = entry->next)
+		if (entry->nsid == nsid)
+			return entry->name;
+	return NULL;
+}
+
+static void netns_map_refresh(void)
+{
+	struct mnl_socket *nl = NULL;
+	struct dirent *entry;
+	unsigned int seq = time(NULL);
+	void *buffer = NULL;
+	DIR *dir = NULL;
+
+	dir = opendir(RUNSTATEDIR "/netns");
+	if (!dir)
+		goto out;
+	nl = mnl_socket_open(NETLINK_ROUTE);
+	if (!nl || mnl_socket_bind(nl, 0, MNL_SOCKET_AUTOPID) < 0)
+		goto out;
+	buffer = calloc(SOCKET_BUFFER_SIZE, 1);
+	if (!buffer)
+		goto out;
+
+	while ((entry = readdir(dir))) {
+		struct netns_map_entry *mapped;
+		int32_t nsid;
+		int fd;
+
+		if (entry->d_name[0] == '.' &&
+		    (!entry->d_name[1] ||
+		     (entry->d_name[1] == '.' && !entry->d_name[2])))
+			continue;
+		fd = openat(dirfd(dir), entry->d_name, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		nsid = netns_id_from_fd(nl, buffer, fd, ++seq);
+		close(fd);
+		if (nsid < 0 || netns_map_find(nsid))
+			continue;
+		mapped = calloc(1, sizeof(*mapped));
+		if (!mapped)
+			break;
+		mapped->name = strdup(entry->d_name);
+		if (!mapped->name) {
+			free(mapped);
+			break;
+		}
+		mapped->nsid = nsid;
+		mapped->next = netns_map;
+		netns_map = mapped;
+	}
+
+out:
+	free(buffer);
+	if (nl)
+		mnl_socket_close(nl);
+	if (dir)
+		closedir(dir);
+}
+
+static char *kernel_get_netns_name(int32_t nsid)
+{
+	const char *name;
+
+	if (nsid < 0)
+		return NULL;
+	name = netns_map_find(nsid);
+	if (!name) {
+		netns_map_refresh();
+		name = netns_map_find(nsid);
+	}
+	return name ? strdup(name) : NULL;
+}
+
 static int parse_linkinfo(const struct nlattr *attr, void *data)
 {
 	struct interface *interface = data;
@@ -706,6 +851,12 @@ static int parse_device(const struct nlattr *attr, void *data)
 			device->flags |= WGDEVICE_HAS_DISABLE_COOKIES;
 		}
 		break;
+	case WGDEVICE_A_CREATING_NET:
+		if (!mnl_attr_validate(attr, MNL_TYPE_U32)) {
+			device->creating_net_nsid = mnl_attr_get_s32(attr);
+			device->flags |= WGDEVICE_HAS_CREATING_NET;
+		}
+		break;
 	}
 
 #undef parse_string_attr
