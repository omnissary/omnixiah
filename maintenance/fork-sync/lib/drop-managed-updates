#!/usr/bin/env bash

set -euo pipefail

todo=$1
temporary=$(mktemp "${todo}.XXXXXX")
trap 'rm -f "$temporary"' EXIT

while IFS= read -r line || [[ -n $line ]]; do
  case $line in
    pick\ * | reword\ * | edit\ * | squash\ * | fixup\ *)
      action=${line%% *}
      remainder=${line#* }
      commit=${remainder%% *}
      if git log -1 --format=%B "$commit" | grep -q '^Omnixiah-Managed-Update: '; then
        line="drop ${line#"$action "}"
      fi
      ;;
  esac
  printf '%s\n' "$line" >>"$temporary"
done <"$todo"

mv "$temporary" "$todo"
trap - EXIT
